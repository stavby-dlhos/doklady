# ============ POVINNÉ ============

# PostgreSQL. Na Railway sa vyplní samo, ak pridáš Postgres do projektu.
DATABASE_URL=postgresql://user:heslo@host:5432/doklady

# Tajný kľúč na podpisovanie prihlasovacích cookies. Minimálne 32 znakov.
# Vygeneruj: openssl rand -base64 48
AUTH_SECRET=

# Verejná adresa aplikácie, napr. https://doklady.stavbydlhos.sk
APP_URL=http://localhost:3000

# ============ OCR (vyťaženie dokladov) ============

# Kľúč z console.anthropic.com. Bez neho sa doklady zakladajú bez vyťaženia.
ANTHROPIC_API_KEY=
OCR_MODEL=claude-sonnet-4-5

# ============ ÚLOŽISKO SKENOV ============
# Na Railway je disk efemérny – bez S3 sa skeny po nasadení stratia.
# Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============ ODOSIELANIE POŠTY (SMTP) ============
# Websupport: smtp.m1.websupport.sk, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Stavby-Dlhoš, s.r.o. <fakturacia@stavbydlhos.sk>"
SMTP_REPLY_TO=

# ============ PRÍJEM POŠTY (IMAP) – elektronická podateľňa ============
# Schránka, kam sa preposielajú faktúry a fotia bločky.
# Websupport: imap.m1.websupport.sk, port 993
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=doklady@stavbydlhos.sk
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# ============ AUTOMATICKÉ ÚLOHY ============
# Tajný kľúč, ktorým sa autentifikuje cron voči /api/cron/*.
# Vygeneruj: openssl rand -hex 32
CRON_SECRET=

# ============ ZÁLOHY ============
# Kam sa ukladá denná záloha databázy (S3 kľúče vyššie sa použijú aj sem).
BACKUP_BUCKET=
BACKUP_PREFIX=zalohy/
